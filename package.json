{
  "name": "buzz",
  "version": "2.0.0",
  "type": "module",
  "description": "Buzz, a Javascript HTML5 Audio library",
  "homepage": "http://buzz.jaysalvat.com",
  "author": "Jay Salvat",
  "license": "MIT",
  "main": "dist/buzz.js",
  "module": "dist/buzz.js",
  "types": "dist/buzz.d.ts",
  "files": [
    "dist/",
    "src/",
    "README.md",
    "CHANGELOG.md",
    "MIT-LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:jaysalvat/buzz.git"
  },
  "keywords": [
    "html5",
    "audio",
    "library",
    "buzz",
    "buzz.js"
  ],
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "lint": "eslint src/**/*.js tests/**/*.js eslint.config.js",
    "test": "npm run lint && node tests/test-all.js",
    "preversion": "npm test",
    "version": "npm run build && git add -A dist",
    "postversion": "git push && git push --tags",
    "release:patch": "npm version patch -m 'Release v%s'",
    "release:minor": "npm version minor -m 'Release v%s'",
    "release:major": "npm version major -m 'Release v%s'"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "eslint": "^8.57.0",
    "puppeteer": "^24.37.3",
    "rollup": "^4.9.6"
  }
}
